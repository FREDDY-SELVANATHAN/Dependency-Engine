{
  "name": "TestApp",

  "forms": [
    {
      "name": "Order",

      "fields": [
        {
          "name": "OrderNo",
          "type": "text"
        },
        {
          "name": "Total",
          "type": "currency",
          "formula": "Qty * Rate"
        }
      ],

      "validations": [
        {
          "name": "PositiveTotal",
          "condition": "Total > 0"
        }
      ]
    }
  ],

  "reports": [
    {
      "name": "BigOrders",
      "filter": "Total > 10000",
      "sort": "Total desc",
      "columns": [
        "OrderNo",
        "Total"
      ]
    }
  ],

  "workflows": [
    {
      "name": "NotifyBigOrder",
      "condition": "Total > 10000",
      "action": "notify(Customer.Name)"
    }
  ]
}
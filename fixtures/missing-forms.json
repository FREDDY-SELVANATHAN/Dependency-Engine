{
  "name": "OrderTracker",
  "reports": [
    {
      "name": "BigOrders",
      "filter": "Total > 10000",
      "sort": "Total desc",
      "columns": [
        "OrderNo",
        "Customer.Name",
        "Total",
        "Discount"
      ]
    },
    {
      "name": "GoldCustomerOrders",
      "filter": "Customer.Tier == \"Gold\"",
      "sort": "OrderDate desc",
      "columns": [
        "OrderNo",
        "Total"
      ]
    }
  ],
  "workflows": [
    {
      "name": "NotifyBigOrder",
      "condition": "Total > 10000",
      "action": "notify(Customer.Name)"
    }
  ]
}
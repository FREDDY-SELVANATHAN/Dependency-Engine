{
  "name": "OrderTracker",

  "forms": [
    {
      "name": "Customer",
      "fields": [
        {
          "name": "Name"
        },
        {
          "name": "Tier",
          "type": "picklist"
        },
        {
          "name": "DiscountPct",
          "type": "number"
        }
      ],
      "validations": []
    },

    {
      "name": "OrderItem",
      "fields": [
        {
          "name": "Product",
          "type": "text"
        },
        {
          "name": "Qty",
          "type": "number"
        },
        {
          "name": "Rate",
          "type": "currency"
        },
        {
          "name": "LineTotal",
          "type": "currency",
          "formula": "Qty * Rate"
        }
      ],
      "validations": []
    },

    {
      "name": "Order",
      "fields": [
        {
          "name": "OrderNo",
          "type": "text"
        },
        {
          "name": "OrderDate",
          "type": "date"
        },
        {
          "name": "Customer",
          "type": "lookup",
          "lookup": "Customer"
        },
        {
          "name": "Items",
          "type": "subform",
          "subform": "OrderItem"
        },
        {
          "name": "SubTotal",
          "type": "currency",
          "formula": "Sum(Items.LineTotal)"
        },
        {
          "name": "Discount",
          "type": "currency",
          "formula": "SubTotal * Customer.DiscountPct / 100"
        },
        {
          "name": "Total",
          "type": "currency",
          "formula": "SubTotal - Discount"
        },
        {
          "name": "Label",
          "type": "text",
          "formula": "Concat(OrderNo, \" - \", Customer.Name)"
        }
      ],
      "validations": [
        {
          "name": "PositiveTotal",
          "condition": "Total > 0"
        },
        {
          "name": "DiscountSane",
          "condition": "Discount <= SubTotal"
        }
      ]
    }
  ],

  "reports": [
    {
      "name": "BigOrders",
      "filter": "Total > 10000",
      "sort": "Total desc",
      "columns": [
        "OrderNo",
        "Customer.Name",
        "Total",
        "Discount"
      ]
    },
    {
      "name": "GoldCustomerOrders",
      "filter": "Customer.Tier == \"Gold\"",
      "sort": "OrderDate desc",
      "columns": [
        "OrderNo",
        "Total"
      ]
    }
  ],

  "workflows": [
    {
      "name": "NotifyBigOrder",
      "condition": "Total > 10000",
      "action": "notify(Customer.Name)"
    }
  ]
}